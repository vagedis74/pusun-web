[Unit]
Description=Pusun Web AI drill generator (Flask, Claude Opus via claude-gateway)
After=network-online.target claude-gateway.service
Wants=claude-gateway.service

[Service]
WorkingDirectory=@REPO@/ai
Environment=DRILL_GATEWAY_URL=http://127.0.0.1:8787
Environment=DRILL_GATEWAY_TOKEN_FILE=%h/.config/claude-gateway.token
Environment=DRILL_MODEL=claude-opus-5-5
Environment=DRILL_MAX_PER_HOUR=20
ExecStart=@REPO@/ai/.venv/bin/gunicorn -w 1 --threads 4 -b 127.0.0.1:8918 --access-logfile - app:app
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
